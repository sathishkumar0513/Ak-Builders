# ---- Local development (Windows PC) ----
DEBUG=True
SECRET_KEY=generate-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=arbuilders
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

COMPANY_STATE_CODE=33
COMPANY_STATE_NAME=Tamil Nadu

DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=Admin@12345
DEMO_ADMIN_EMAIL=admin@akbuilders.local

# --- Security (defaults are fine for local use) ---
# Lock an account after this many wrong passwords, for this many minutes
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# Wrong logins per minute from one IP address
LOGIN_THROTTLE_RATE=5/min
# Excel / PDF report downloads per user per minute
EXPORT_THROTTLE_RATE=30/min
# Production: move the Django admin to a hard-to-guess path, e.g. office-7f3k2/
ADMIN_URL=admin/
# Production with several Gunicorn workers: share lockouts and rate limits through Redis
# CACHE_URL=redis://localhost:6379/1
